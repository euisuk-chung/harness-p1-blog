{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_sources.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
